# Select `ollama` for local models or `azure` for the external calibration model.
MODEL_ENDPOINT=ollama

# Local Ollama endpoint. The model is normally passed from paper/models.json.
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_KEEP_ALIVE=60m
OLLAMA_TIMEOUT_SECONDS=900
OLLAMA_MAX_RETRIES=2
REASONING_FLOOR_PARALLEL_WORKERS=1

# Azure OpenAI-compatible endpoint for sequential calibration calls. Never commit a real key.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
# Data-plane deployment alias. The frozen matrix keeps the dated snapshot as
# cache/provenance identity and verifies that Azure resolves this alias to it.
# AZURE_OPENAI_DEPLOYMENT=gpt-5.6-sol
# AZURE_OPENAI_API_KEY=<secret>
AZURE_OPENAI_TIMEOUT_SECONDS=900
AZURE_OPENAI_RETRY_BASE_SECONDS=2
AZURE_OPENAI_RETRY_MAX_SECONDS=20
# The frozen matrix passes two retries explicitly, overriding this optional developer default.
# AZURE_OPENAI_MAX_RETRIES=2
