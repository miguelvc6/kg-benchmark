# Select `ollama` for local models or `azure` for the external calibration model.
MODEL_ENDPOINT=ollama

# Local Ollama endpoint. The model is normally passed from paper/models.json.
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_KEEP_ALIVE=60m
OLLAMA_TIMEOUT_SECONDS=900
OLLAMA_MAX_RETRIES=2
REASONING_FLOOR_PARALLEL_WORKERS=1

# Azure OpenAI-compatible endpoint for sequential calibration calls. Never commit a real key.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
# The frozen matrix passes its dated snapshot explicitly; this is only a developer default.
# AZURE_OPENAI_DEPLOYMENT=gpt-5.6-sol-2026-07-09
# AZURE_OPENAI_API_KEY=<secret>
