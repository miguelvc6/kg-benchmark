{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg-benchmark.local/schemas/selection-ranking.schema.json",
  "title": "Frozen Selection Ranking",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_type", "manifest_version", "algorithm", "seed", "group_units", "tbox_weighted_prefix_target", "tie_break"],
  "properties": {
    "manifest_type": {"const": "selection_ranking"},
    "manifest_version": {"const": 1},
    "algorithm": {"const": "sha256"},
    "seed": {"const": 13},
    "group_units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A_BOX", "T_BOX"],
      "properties": {
        "A_BOX": {"const": "qid_property"},
        "T_BOX": {"const": "property_revision"}
      }
    },
    "tbox_weighted_prefix_target": {"type": "object", "minProperties": 3},
    "tie_break": {"const": "case_id"}
  }
}
