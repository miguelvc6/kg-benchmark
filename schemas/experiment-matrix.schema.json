{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg-benchmark.local/schemas/experiment-matrix.schema.json",
  "title": "Materialized Paper Experiment Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_type", "manifest_version", "matrix_id", "dataset", "model_configuration", "protocol",
    "dimensions", "populations", "models", "cells", "requests", "workload", "validation"
  ],
  "properties": {
    "manifest_type": {"const": "paper_experiment_matrix"},
    "manifest_version": {"const": 1},
    "matrix_id": {"type": "string", "pattern": "^matrix_[0-9a-f]{20}$"},
    "dataset": {"type": "object", "additionalProperties": {"$ref": "#/$defs/artifact"}},
    "model_configuration": {"$ref": "#/$defs/artifact"},
    "protocol": {"$ref": "#/$defs/artifact"},
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "prompt_regimes", "context_bundles"],
      "properties": {
        "tasks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["repair_proposal", "track_diagnosis"]}},
        "prompt_regimes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["zero_shot", "static_few_shot"]}},
        "context_bundles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["logic_only", "local_graph"]}}
      }
    },
    "populations": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/population"}},
    "models": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "cells": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cell"}},
    "requests": {"$ref": "#/$defs/artifact"},
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_requests", "logical_cells", "execution_groups", "by_model"],
      "properties": {
        "expected_requests": {"type": "integer", "minimum": 1},
        "logical_cells": {"type": "integer", "minimum": 1},
        "execution_groups": {"type": "integer", "minimum": 1},
        "by_model": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population_not_in_generation_identity", "tools_disabled", "provider_policies_valid"],
      "properties": {
        "population_not_in_generation_identity": {"const": true},
        "tools_disabled": {"const": true},
        "provider_policies_valid": {"const": true}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "records": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "case_count"],
      "properties": {
        "artifact": {"$ref": "#/$defs/artifact"},
        "case_count": {"type": "integer", "minimum": 1}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_id", "execution_group_id", "model_id", "population", "task", "prompt_regime", "context_bundle", "expected_requests", "manifest_path"],
      "properties": {
        "cell_id": {"type": "string", "pattern": "^cell_[0-9a-f]{20}$"},
        "execution_group_id": {"type": "string", "pattern": "^group_[0-9a-f]{20}$"},
        "model_id": {"type": "string", "minLength": 1},
        "population": {"type": "string", "minLength": 1},
        "task": {"enum": ["repair_proposal", "track_diagnosis"]},
        "prompt_regime": {"enum": ["zero_shot", "static_few_shot"]},
        "context_bundle": {"enum": ["logic_only", "local_graph"]},
        "expected_requests": {"type": "integer", "minimum": 1},
        "manifest_path": {"type": "string", "minLength": 1}
      }
    }
  }
}
