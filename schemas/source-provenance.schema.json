{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg-benchmark.local/schemas/source-provenance.schema.json",
  "title": "Final Dataset Source Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_type",
    "manifest_version",
    "recorded_at_utc",
    "git_revision",
    "acquisition_config",
    "sources",
    "cache_provenance"
  ],
  "properties": {
    "manifest_type": {"const": "source_provenance"},
    "manifest_version": {"const": 2},
    "recorded_at_utc": {"type": "string", "format": "date-time"},
    "git_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "acquisition_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "config"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest_type", "manifest_version", "status", "started_at_utc", "completed_at_utc", "command", "arguments", "methodology"],
          "properties": {
            "manifest_type": {"const": "dataset_acquisition"},
            "manifest_version": {"const": 1},
            "status": {"const": "complete"},
            "started_at_utc": {"type": "string", "format": "date-time"},
            "completed_at_utc": {"type": "string", "format": "date-time"},
            "command": {"const": "acquire"},
            "arguments": {"type": "array", "items": {"type": "string"}},
            "methodology": {
              "type": "object",
              "additionalProperties": false,
              "required": ["freeze_scope_sha256", "source_git_revision", "methodology_lock_sha256"],
              "properties": {
                "freeze_scope_sha256": {"$ref": "#/$defs/sha256"},
                "source_git_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "methodology_lock_sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["popularity", "candidates", "repairs", "world_state", "wikidata_dump"],
      "properties": {
        "popularity": {"$ref": "#/$defs/source"},
        "candidates": {"$ref": "#/$defs/source"},
        "repairs": {"$ref": "#/$defs/source"},
        "world_state": {"$ref": "#/$defs/source"},
        "wikidata_dump": {"$ref": "#/$defs/source"}
      }
    },
    "cache_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "file_count", "total_bytes", "aggregate_sha256", "files"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "file_count": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 0},
        "aggregate_sha256": {"$ref": "#/$defs/sha256"},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "bytes", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "bytes": {"type": "integer", "minimum": 0},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
