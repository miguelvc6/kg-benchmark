{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg-benchmark.local/schemas/support-bank.schema.json",
  "title": "Few-Shot Support Bank",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_type", "manifest_version", "capacity_per_locus", "support_sets"],
  "properties": {
    "manifest_type": {"const": "few_shot_support_bank"},
    "manifest_version": {"const": 1},
    "capacity_per_locus": {"const": 16},
    "support_sets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a_box_repair", "t_box_repair", "track_diagnosis"],
      "properties": {
        "a_box_repair": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/row"}},
        "t_box_repair": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/row"}},
        "track_diagnosis": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/row"}}
      }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "group_key", "role", "visible_example_id"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "group_key": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "visible_example_id": {"type": "string", "pattern": "^example_[0-9]{6}$"}
      }
    }
  }
}
