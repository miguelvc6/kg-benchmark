{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg-benchmark.local/schemas/execution_matrix.schema.json",
  "title": "Paper execution model and population matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_type",
    "manifest_version",
    "matrix_id",
    "status",
    "prompt_configuration",
    "prompt_configuration_sha256",
    "tbox_task_version",
    "reporting_policy",
    "generation_cache_root",
    "populations",
    "models"
  ],
  "properties": {
    "manifest_type": {"const": "paper_execution_matrix"},
    "manifest_version": {"const": 1},
    "matrix_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "frozen"]},
    "prompt_configuration": {"type": ["string", "null"]},
    "prompt_configuration_sha256": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "tbox_task_version": {"const": "tbox_taxonomy_patch_v1"},
    "reporting_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "combined_abox_tbox_score",
        "strict_signature_role",
        "tbox_gold_requirement",
        "unsupported_tbox_repair_ops"
      ],
      "properties": {
        "combined_abox_tbox_score": {"const": false},
        "strict_signature_role": {"const": "legacy_exploratory_only"},
        "tbox_gold_requirement": {"const": "complete_mechanically_supported_gold"},
        "unsupported_tbox_repair_ops": {
          "type": "array",
          "const": ["CLASS_HIERARCHY_ADD", "EXCEPTION_ADD"]
        }
      }
    },
    "generation_cache_root": {"type": "string", "minLength": 1},
    "populations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "population_id",
          "role",
          "selection_manifest",
          "selection_sha256",
          "expected_case_count",
          "ablation_bundles",
          "proposal_track_mode",
          "oracle_diagnosis_mode"
        ],
        "properties": {
          "population_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["main_score", "nested_api_calibration", "extension"]},
          "selection_manifest": {"type": "string", "minLength": 1},
          "selection_sha256": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            ]
          },
          "expected_case_count": {"type": "integer", "minimum": 1},
          "ablation_bundles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["minimal_case", "logic_only", "local_graph"]}
          },
          "proposal_track_mode": {"enum": ["oracle", "diagnosis_routed"]},
          "oracle_diagnosis_mode": {"enum": ["run", "skip"]}
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "provider",
          "model",
          "model_digest",
          "population_id",
          "execution_mode",
          "parallel_workers",
          "reasoning_effort",
          "context_length",
          "max_output_tokens",
          "temperature",
          "top_p",
          "seed",
          "ollama_think",
          "transport_max_retries",
          "tools_disabled",
          "batch_sync_retry_fallback",
          "enabled"
        ],
        "properties": {
          "model_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "provider": {"enum": ["ollama", "azure", "openai", "university"]},
          "model": {"type": "string", "minLength": 1},
          "model_digest": {"type": ["string", "null"]},
          "population_id": {"type": "string", "minLength": 1},
          "execution_mode": {"enum": ["sync", "parallel", "batch"]},
          "parallel_workers": {"type": ["integer", "null"], "minimum": 1},
          "reasoning_effort": {
            "type": ["string", "null"],
            "enum": [null, "none", "minimal", "low", "medium", "high", "xhigh"]
          },
          "context_length": {"type": ["integer", "null"], "minimum": 1},
          "max_output_tokens": {"type": "integer", "minimum": 1},
          "temperature": {"type": ["number", "null"], "minimum": 0},
          "top_p": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1},
          "seed": {"type": ["integer", "null"]},
          "ollama_think": {
            "type": ["string", "null"],
            "enum": [null, "enabled", "disabled", "low", "medium", "high", "max"]
          },
          "transport_max_retries": {"type": "integer", "minimum": 0},
          "tools_disabled": {"const": true},
          "batch_sync_retry_fallback": {"type": "boolean"},
          "enabled": {"type": "boolean"}
        }
      }
    }
  }
}
