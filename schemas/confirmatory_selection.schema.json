{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg-benchmark.local/schemas/confirmatory_selection.schema.json",
  "title": "Private Confirmatory Reserve Or Final Selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_type", "manifest_version", "seed", "snapshot_id", "inputs", "policy", "selected_case_ids", "case_annotations", "counts"],
  "properties": {
    "manifest_type": {"enum": ["confirmatory_reserve_private", "confirmatory_final_private"]},
    "manifest_version": {"const": 3},
    "seed": {"const": 13},
    "snapshot_id": {"type": "string", "minLength": 1},
    "inputs": {"type": "object"},
    "policy": {"type": "object"},
    "selected_case_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "api_subset_case_ids": {"type": "array", "minItems": 600, "maxItems": 600, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "case_annotations": {"type": "object", "additionalProperties": {"type": "object"}},
    "counts": {"type": "object"},
    "eligible_group_counts": {"type": "object"},
    "reserve_commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection_commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"manifest_type": {"const": "confirmatory_reserve_private"}}},
      "then": {"required": ["reserve_commitment", "eligible_group_counts"]}
    },
    {
      "if": {"properties": {"manifest_type": {"const": "confirmatory_final_private"}}},
      "then": {
        "required": ["selection_commitment", "api_subset_case_ids"],
        "properties": {"selected_case_ids": {"minItems": 1200, "maxItems": 1200}}
      }
    }
  ]
}
