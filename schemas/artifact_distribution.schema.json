{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg-benchmark.local/schemas/artifact_distribution.schema.json",
  "title": "KG Benchmark Artifact Distribution Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_type", "manifest_version", "status", "release", "source_snapshots", "artifacts"],
  "properties": {
    "manifest_type": {"const": "kg_benchmark_distribution"},
    "manifest_version": {"const": 1},
    "status": {"enum": ["draft", "published"]},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_version",
        "repository_url",
        "source_commit",
        "release_manifest_url",
        "release_manifest_sha256"
      ],
      "properties": {
        "benchmark_version": {"type": "string", "minLength": 1},
        "repository_url": {"type": "string", "format": "uri"},
        "source_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "release_manifest_url": {"type": ["string", "null"], "format": "uri"},
        "release_manifest_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "description",
          "status",
          "snapshot_at_utc",
          "source_url",
          "upstream_license_id",
          "notes"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "status": {"enum": ["resolved", "unresolved"]},
          "snapshot_at_utc": {"type": ["string", "null"], "format": "date-time"},
          "source_url": {"type": ["string", "null"], "format": "uri"},
          "upstream_license_id": {"type": ["string", "null"]},
          "notes": {"type": "string"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "role",
          "path",
          "required",
          "status",
          "urls",
          "sha256",
          "size_bytes",
          "media_type",
          "license_id",
          "source_snapshot_ids",
          "notes"
        ],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "required": {"type": "boolean"},
          "status": {"enum": ["bundled", "published", "unresolved"]},
          "urls": {
            "type": "array",
            "items": {"type": "string", "format": "uri"}
          },
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": ["integer", "null"], "minimum": 0},
          "media_type": {"type": "string", "minLength": 1},
          "license_id": {"type": ["string", "null"]},
          "source_snapshot_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "notes": {"type": "string"}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "published"}}, "required": ["status"]},
            "then": {
              "properties": {
                "urls": {"minItems": 1},
                "sha256": {"type": "string"},
                "size_bytes": {"type": "integer"},
                "license_id": {"type": "string", "minLength": 1}
              }
            }
          },
          {
            "if": {"properties": {"status": {"const": "bundled"}}, "required": ["status"]},
            "then": {
              "properties": {
                "sha256": {"type": "string"},
                "size_bytes": {"type": "integer"}
              }
            }
          },
          {
            "if": {"properties": {"status": {"const": "unresolved"}}, "required": ["status"]},
            "then": {
              "properties": {
                "urls": {"maxItems": 0},
                "sha256": {"type": "null"},
                "size_bytes": {"type": "null"}
              }
            }
          }
        ]
      }
    }
  }
}
