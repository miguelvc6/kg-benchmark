{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg-benchmark.local/schemas/release_manifest.schema.json",
  "title": "KG Benchmark Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_type",
    "manifest_version",
    "created_at_utc",
    "release_kind",
    "status",
    "code",
    "validation",
    "files"
  ],
  "properties": {
    "manifest_type": {"const": "kg_benchmark_release"},
    "manifest_version": {"const": 2},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "release_kind": {"enum": ["dataset", "evaluation"]},
    "status": {"enum": ["candidate", "confirmatory"]},
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": ["string", "null"]},
        "dirty": {"type": ["boolean", "null"]}
      }
    },
    "validation": {
      "type": "object",
      "required": ["passed", "release_kind", "checks", "counts"],
      "properties": {
        "passed": {"type": "boolean"},
        "release_kind": {"enum": ["dataset", "evaluation"]},
        "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "counts": {"type": "object"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "size_bytes", "sha256"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
