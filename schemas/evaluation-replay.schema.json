{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg-benchmark.local/schemas/evaluation-replay.schema.json",
  "title": "Provider-free evaluation replay manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_type", "manifest_version", "evaluation_id", "created_at_utc", "source_run_dir", "provider_calls",
    "selected_case_count", "ablation_bundles", "metric_families", "combined_repair_success_score", "source_artifacts",
    "evaluation_code", "outputs"
  ],
  "properties": {
    "manifest_type": {"const": "evaluation_replay"},
    "manifest_version": {"const": 1},
    "evaluation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "source_run_dir": {"type": "string", "minLength": 1},
    "provider_calls": {"const": 0},
    "selected_case_count": {"type": "integer", "minimum": 1},
    "ablation_bundles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["logic_only", "local_graph"]}},
    "metric_families": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["a_box_repair_v1", "tbox_taxonomy_patch_v1", "track_diagnosis_v1"]}
    },
    "combined_repair_success_score": {"const": false},
    "source_artifacts": {"type": "object"},
    "evaluation_code": {"type": "object"},
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "required": ["combined_summary"],
      "properties": {
        "combined_summary": {"$ref": "#/$defs/artifact"}
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "traces", "summary", "tbox_taxonomy_patch_traces", "tbox_taxonomy_patch_summary",
          "diagnosis_traces", "diagnosis_summary"
        ],
        "properties": {
          "traces": {"$ref": "#/$defs/artifact"},
          "summary": {"$ref": "#/$defs/artifact"},
          "tbox_taxonomy_patch_traces": {"oneOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
          "tbox_taxonomy_patch_summary": {"oneOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
          "diagnosis_traces": {"$ref": "#/$defs/artifact"},
          "diagnosis_summary": {"$ref": "#/$defs/artifact"}
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
