{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg-benchmark.local/schemas/research_protocol.schema.json",
  "title": "Frozen Research Protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_type",
    "manifest_version",
    "protocol_id",
    "protocol_phase",
    "status",
    "created_at_utc",
    "code",
    "release",
    "models",
    "conditions",
    "expected_population",
    "files"
  ],
  "properties": {
    "manifest_type": {"const": "research_protocol_freeze"},
    "manifest_version": {"enum": [2, 3]},
    "protocol_id": {"type": "string", "minLength": 1},
    "protocol_phase": {"enum": ["methodology", "allocation", "execution"]},
    "status": {"enum": ["draft", "frozen"]},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "code": {
      "type": "object",
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": ["string", "null"]},
        "dirty": {"type": ["boolean", "null"]}
      }
    },
    "release": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "release_kind", "release_status"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "release_kind": {"enum": ["dataset", "evaluation"]},
            "release_status": {"enum": ["candidate", "confirmatory"]}
          }
        }
      ]
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "digest"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "digest": {"type": ["string", "null"], "minLength": 8}
        }
      }
    },
    "conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "expected_population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_count", "main_score_count"],
      "properties": {
        "selected_count": {"type": "integer", "minimum": 1},
        "main_score_count": {"type": "integer", "minimum": 1}
      }
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "size_bytes", "sha256"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"protocol_phase": {"const": "methodology"}}},
      "then": {"properties": {"release": {"type": "null"}}},
      "else": {"properties": {"release": {"type": "object"}}}
    }
  ]
}
