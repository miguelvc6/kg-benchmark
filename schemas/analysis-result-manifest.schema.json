{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg-benchmark.local/schemas/analysis-result-manifest.schema.json",
  "title": "Compact paper result package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_type", "manifest_version", "analysis_id", "scope", "matrix_id", "evaluation_id", "provider_calls",
    "analysis_configuration", "analysis_code", "dependency_lock", "matrix", "evaluation_manifests", "outputs", "validation"
  ],
  "properties": {
    "manifest_type": {"const": "paper_analysis_results"},
    "manifest_version": {"const": 1},
    "analysis_id": {"type": "string", "pattern": "^analysis_[0-9a-f]{20}$"},
    "scope": {"enum": ["confirmatory_and_calibration", "extension"]},
    "matrix_id": {"type": "string", "pattern": "^matrix_[0-9a-f]{20}$"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "provider_calls": {"const": 0},
    "analysis_configuration": {"$ref": "#/$defs/artifact"},
    "analysis_code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "statistics"],
      "properties": {
        "workflow": {"$ref": "#/$defs/artifact"},
        "statistics": {"$ref": "#/$defs/artifact"}
      }
    },
    "dependency_lock": {"$ref": "#/$defs/artifact"},
    "matrix": {"$ref": "#/$defs/artifact"},
    "evaluation_manifests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}},
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/artifact"}
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete_matrix", "complete_evaluation_coverage", "no_provider_calls", "models_not_pooled",
        "loci_not_combined", "roles_separated", "four_contrasts_per_holm_family", "extensions_do_not_replace_confirmatory"
      ],
      "properties": {
        "complete_matrix": {"const": true},
        "complete_evaluation_coverage": {"const": true},
        "no_provider_calls": {"const": true},
        "models_not_pooled": {"const": true},
        "loci_not_combined": {"const": true},
        "roles_separated": {"const": true},
        "four_contrasts_per_holm_family": {"const": true},
        "extensions_do_not_replace_confirmatory": {"const": true}
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "records": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
