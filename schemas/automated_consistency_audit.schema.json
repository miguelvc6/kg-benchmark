{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg-benchmark.local/schemas/automated_consistency_audit.schema.json",
  "title": "Automated Consistency Audit Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_type",
    "manifest_version",
    "created_at_utc",
    "output_dir",
    "inputs",
    "parameters",
    "git",
    "world_state_index",
    "counts",
    "artifacts"
  ],
  "properties": {
    "manifest_type": {"const": "automated_consistency_audit"},
    "manifest_version": {"const": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "output_dir": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "object",
      "required": [
        "classified_benchmark",
        "classified_benchmark_sha256",
        "world_state",
        "world_state_sha256",
        "stage4_schema",
        "stage4_schema_sha256",
        "construct_sample",
        "construct_sample_sha256",
        "rendered_prompts",
        "rendered_prompts_sha256",
        "render_summary",
        "render_summary_sha256",
        "stage2"
      ],
      "properties": {
        "classified_benchmark": {"type": "string", "minLength": 1},
        "classified_benchmark_sha256": {"$ref": "#/$defs/sha256"},
        "world_state": {"type": "string", "minLength": 1},
        "world_state_sha256": {"$ref": "#/$defs/sha256"},
        "stage4_schema": {"type": "string", "minLength": 1},
        "stage4_schema_sha256": {"$ref": "#/$defs/sha256"},
        "construct_sample": {"type": "string", "minLength": 1},
        "construct_sample_sha256": {"$ref": "#/$defs/sha256"},
        "rendered_prompts": {"type": "string", "minLength": 1},
        "rendered_prompts_sha256": {"$ref": "#/$defs/sha256"},
        "render_summary": {"type": "string", "minLength": 1},
        "render_summary_sha256": {"$ref": "#/$defs/sha256"},
        "stage2": {"type": ["string", "null"]}
      }
    },
    "parameters": {
      "type": "object",
      "required": ["construct_review_size", "temporal_review_size", "seed"],
      "properties": {
        "construct_review_size": {"type": "integer", "minimum": 1},
        "temporal_review_size": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer"}
      }
    },
    "git": {
      "type": "object",
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": ["string", "null"]},
        "dirty": {"type": ["boolean", "null"]}
      }
    },
    "world_state_index": {"type": "object"},
    "counts": {
      "type": "object",
      "required": ["stage4_rows", "construct_review_packets", "temporal_review_packets"],
      "properties": {
        "stage4_rows": {"type": "integer", "minimum": 0},
        "construct_review_packets": {"type": "integer", "minimum": 1},
        "temporal_review_packets": {"type": "integer", "minimum": 1}
      }
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
