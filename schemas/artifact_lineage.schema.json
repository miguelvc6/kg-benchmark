{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg-benchmark.local/schemas/artifact_lineage.schema.json",
  "title": "KG Artifact Lineage Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_type", "manifest_version", "created_at_utc", "git_revision", "artifacts", "source_provenance", "validation"],
  "properties": {
    "manifest_type": {"const": "kg_artifact_lineage"},
    "manifest_version": {"enum": [2, 3]},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "git_revision": {"type": ["string", "null"]},
    "artifacts": {
      "type": "object",
      "required": ["stage0", "stage1", "stage2_json", "stage2_jsonl", "stage3", "stage4"],
      "additionalProperties": {"$ref": "#/$defs/artifact"}
    },
    "source_provenance": {"type": "array", "items": {"type": "object"}},
    "validation_reuse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "prior_manifest_path", "prior_manifest_sha256", "reused_subchecks", "recomputed_subchecks", "all_artifact_hashes_reverified"],
      "properties": {
        "mode": {"const": "content_bound_subcheck_reuse"},
        "prior_manifest_path": {"type": "string", "minLength": 1},
        "prior_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reused_subchecks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "recomputed_subchecks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "all_artifact_hashes_reverified": {"const": true}
      }
    },
    "validation": {
      "type": "object",
      "required": ["passed", "stage2_representation_equivalence", "stage0_stage1_provenance", "stage234_identity_and_projection"],
      "properties": {
        "passed": {"type": "boolean"},
        "authoritative_stage2_artifact": {"const": "stage2_json"},
        "stage2_relationship": {"type": "object"},
        "stage2_representation_equivalence": {"type": "object"},
        "stage0_stage1_provenance": {"type": "object"},
        "stage234_identity_and_projection": {"type": "object"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"manifest_version": {"const": 3}}},
      "then": {
        "properties": {
          "validation": {
            "required": ["authoritative_stage2_artifact", "stage2_relationship"]
          }
        }
      }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256", "record_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
