{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg-benchmark.local/schemas/source-candidate.schema.json",
  "title": "Canonical Repair Candidate Row",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "qid",
    "property_id",
    "violation_type",
    "fix_date",
    "report_revision_old",
    "report_revision_new",
    "report_event_sampling"
  ],
  "properties": {
    "qid": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
    "property_id": {"type": "string", "pattern": "^P[1-9][0-9]*$"},
    "violation_type": {"type": "string", "minLength": 1},
    "fix_date": {"type": "string", "minLength": 1},
    "report_revision_old": {"type": ["integer", "null"]},
    "report_revision_new": {"type": ["integer", "null"]},
    "report_event_sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "seed",
        "cap",
        "event_key_sha256",
        "event_candidate_count",
        "selected_candidate_count",
        "rank",
        "capped"
      ],
      "properties": {
        "method": {"const": "sha256_qid_rank_v1"},
        "seed": {"const": 13},
        "cap": {"const": 100},
        "event_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "event_candidate_count": {"type": "integer", "minimum": 1},
        "selected_candidate_count": {"type": "integer", "minimum": 1, "maximum": 100},
        "rank": {"type": "integer", "minimum": 1, "maximum": 100},
        "capped": {"type": "boolean"}
      }
    }
  }
}
