{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg-benchmark.local/schemas/experiment_registry.schema.json",
  "title": "Experiment Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_type", "manifest_version", "entries"],
  "properties": {
    "manifest_type": {"const": "experiment_registry"},
    "manifest_version": {"const": 2},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "experiment_id",
          "registered_at_utc",
          "status",
          "protocol_id",
          "protocol_manifest",
          "protocol_manifest_sha256",
          "run_summary",
          "run_summary_sha256",
          "paper_eligible",
          "ineligibility_reasons",
          "verification_evidence",
          "supersedes",
          "notes"
        ],
        "properties": {
          "experiment_id": {"type": "string", "minLength": 1},
          "registered_at_utc": {"type": "string", "format": "date-time"},
          "status": {"enum": ["exploratory", "confirmatory", "superseded"]},
          "protocol_id": {"type": ["string", "null"]},
          "protocol_manifest": {"type": ["string", "null"]},
          "protocol_manifest_sha256": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            ]
          },
          "run_summary": {"type": "string", "minLength": 1},
          "run_summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "paper_eligible": {"type": "boolean"},
          "ineligibility_reasons": {"type": "array", "items": {"type": "string"}},
          "verification_evidence": {"type": "object"},
          "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
