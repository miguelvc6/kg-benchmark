{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg-benchmark.local/schemas/dataset-case.schema.json",
  "title": "WikidataRepairEval Classified Benchmark Record (Lean v2)",
  "description": "Stable contract for the current lean Stage 4 artifact. Detailed classifier diagnostics may evolve, but join keys, tracks, labels, targets, persistence, popularity, and classification outputs are validated here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "qid",
    "property",
    "track",
    "labels_en",
    "violation_context",
    "repair_target",
    "persistence_check",
    "popularity",
    "context_ref",
    "classification",
    "build"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "qid": {"$ref": "#/$defs/qid"},
    "property": {"$ref": "#/$defs/pid"},
    "track": {"enum": ["A_BOX", "T_BOX"]},
    "information_type": {"type": ["string", "null"]},
    "labels_en": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qid", "property"],
      "properties": {
        "qid": {"$ref": "#/$defs/label"},
        "property": {"$ref": "#/$defs/label"}
      }
    },
    "violation_context": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "report_page_title",
        "report_fix_date",
        "report_revision_old",
        "report_revision_new",
        "report_violation_type_raw",
        "report_violation_type_normalized",
        "report_violation_type_qids",
        "value"
      ],
      "properties": {
        "report_page_title": {"type": "string", "minLength": 1},
        "report_fix_date": {"type": "string", "minLength": 1},
        "report_revision_old": {"type": ["integer", "null"]},
        "report_revision_new": {"type": ["integer", "null"]},
        "report_violation_type_raw": {"type": ["string", "null"]},
        "report_violation_type_normalized": {"type": ["string", "null"]},
        "report_violation_type_qids": {
          "type": "array",
          "items": {"$ref": "#/$defs/qid"},
          "uniqueItems": true
        },
        "value": {},
        "value_current_2026": {}
      }
    },
    "repair_target": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "author"],
      "properties": {
        "kind": {"enum": ["A_BOX", "T_BOX"]},
        "author": {"type": ["string", "null"]},
        "revision_id": {"type": ["integer", "null"]},
        "property_revision_id": {"type": ["integer", "null"]},
        "property_revision_prev": {"type": ["integer", "null"]},
        "action": {"type": ["string", "null"], "enum": ["CREATE", "UPDATE", "DELETE", null]},
        "old_value": {},
        "new_value": {},
        "constraint_delta": {"type": ["object", "null"]}
      }
    },
    "persistence_check": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "current_value_2026"],
      "properties": {
        "status": {"const": "passed"},
        "current_value_2026": {}
      }
    },
    "popularity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "components"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "bucket": {"enum": ["head", "mid", "tail", "unknown"]},
        "components": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "pageviews_365d",
            "out_degree",
            "sitelinks_count",
            "pageviews_norm",
            "degree_norm",
            "sitelinks_norm"
          ],
          "properties": {
            "pageviews_365d": {"type": "integer", "minimum": 0},
            "out_degree": {"type": "integer", "minimum": 0},
            "sitelinks_count": {"type": "integer", "minimum": 0},
            "pageviews_norm": {"type": "number", "minimum": 0, "maximum": 1},
            "degree_norm": {"type": "number", "minimum": 0, "maximum": 1},
            "sitelinks_norm": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "context_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world_state_id", "world_state_path"],
      "properties": {
        "world_state_id": {"type": "string", "minLength": 1},
        "world_state_path": {"type": "string", "minLength": 1}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": true,
      "required": ["class", "subtype", "confidence", "decision_trace", "rationale", "constraint_types"],
      "properties": {
        "class": {"enum": ["TypeA", "TypeB", "TypeC", "T_BOX"]},
        "subtype": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["high", "medium", "low"]},
        "decision_trace": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["step", "result"],
            "properties": {
              "step": {"type": "string", "minLength": 1},
              "result": {}
            },
            "additionalProperties": true
          }
        },
        "rationale": {"type": "string", "minLength": 1},
        "constraint_types": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["qid", "label_en"],
            "properties": {
              "qid": {"$ref": "#/$defs/qid"},
              "label_en": {"type": ["string", "null"]}
            }
          }
        },
        "local_subtype": {"type": ["string", "null"]},
        "diagnostics": {"type": "object"}
      }
    },
    "build": {"type": ["object", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"track": {"const": "T_BOX"}}},
      "then": {
        "properties": {
          "repair_target": {"properties": {"kind": {"const": "T_BOX"}}},
          "classification": {"properties": {"class": {"const": "T_BOX"}}}
        }
      }
    },
    {
      "if": {"properties": {"track": {"const": "A_BOX"}}},
      "then": {
        "properties": {
          "repair_target": {"properties": {"kind": {"const": "A_BOX"}}},
          "classification": {"properties": {"class": {"enum": ["TypeA", "TypeB", "TypeC"]}}}
        }
      }
    }
  ],
  "$defs": {
    "qid": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
    "pid": {"type": "string", "pattern": "^P[1-9][0-9]*$"},
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "description"],
      "properties": {
        "label": {"type": ["string", "null"]},
        "description": {"type": ["string", "null"]}
      }
    }
  }
}
