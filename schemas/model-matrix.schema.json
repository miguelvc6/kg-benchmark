{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg-benchmark.local/schemas/model-matrix.schema.json",
  "title": "Paper Model Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_type", "manifest_version", "status", "request_dimensions", "generation_identity", "models"],
  "properties": {
    "manifest_type": {"const": "paper_model_matrix"},
    "manifest_version": {"const": 1},
    "status": {"enum": ["freeze_candidate", "frozen"]},
    "request_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "prompt_regimes", "context_bundles"],
      "properties": {
        "tasks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["repair_proposal", "track_diagnosis"]}},
        "prompt_regimes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["zero_shot", "static_few_shot"]}},
        "context_bundles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["logic_only", "local_graph"]}}
      }
    },
    "generation_identity": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id", "provider", "model", "model_revision", "revision_status", "revision_resolution",
        "population", "execution_mode", "max_output_tokens", "max_transport_retries", "tools_disabled", "expected_calls"
      ],
      "properties": {
        "model_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
        "provider": {"enum": ["ollama", "azure"]},
        "model": {"type": "string", "minLength": 1},
        "deployment": {"type": "string", "minLength": 1},
        "model_revision": {"type": ["string", "null"]},
        "revision_status": {"enum": ["resolved", "unresolved"]},
        "revision_resolution": {"type": "string", "minLength": 1},
        "population": {"type": "string", "minLength": 1},
        "execution_mode": {"enum": ["sync", "batch"]},
        "temperature": {"type": "number"},
        "top_p": {"type": "number"},
        "seed": {"type": "integer"},
        "context_length": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "ollama_think": {"enum": ["enabled", "disabled", "low", "medium", "high", "max"]},
        "reasoning_effort": {"enum": ["none", "minimal", "low", "medium", "high", "xhigh"]},
        "max_transport_retries": {"type": "integer", "minimum": 0},
        "batch_completion_window": {"type": "string", "minLength": 1},
        "batch_poll_interval_seconds": {"type": "number", "exclusiveMinimum": 0},
        "batch_sync_retry_fallback": {"type": "boolean"},
        "tools_disabled": {"type": "boolean"},
        "expected_calls": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"provider": {"const": "ollama"}}},
          "then": {"required": ["temperature", "top_p", "seed", "context_length", "ollama_think"]}
        },
        {
          "if": {"properties": {"provider": {"const": "azure"}}},
          "then": {"required": ["deployment", "reasoning_effort", "batch_completion_window", "batch_poll_interval_seconds", "batch_sync_retry_fallback"]}
        }
      ]
    }
  }
}
