{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg-benchmark.local/schemas/experiment.schema.json",
  "title": "Resolved paper experiment",
  "type": "object",
  "additionalProperties": true,
  "required": ["experiment_id", "dataset_sha256", "population", "model", "tasks", "prompt_regimes", "context_bundles"],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "population": {"type": "string", "minLength": 1},
    "model": {"type": "object"},
    "tasks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["repair_proposal", "track_diagnosis"]}},
    "prompt_regimes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["zero_shot", "static_few_shot"]}},
    "context_bundles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["logic_only", "local_graph"]}}
  }
}
