{
  "configuration_id": "post_freeze_acquisition_v1",
  "snapshot_root": "data_post_freeze/<snapshot_id>",
  "restored_baseline_root": "data",
  "restored_baseline_write_policy": "read_only",
  "candidate_policy": "refresh_after_methodology_freeze",
  "api_policy": "resumable_wikidata_api",
  "cache_policy": "snapshot_local_isolated_cache",
  "dump_policy": "fresh_download_with_sha256_before_stage3",
  "required_fetcher_controls": [
    "--data-dir",
    "--cache-dir",
    "--dump-path",
    "--refresh-candidates"
  ],
  "required_snapshot_bindings": [
    "source_timestamps",
    "source_checksums",
    "configuration_sha256",
    "cache_provenance",
    "methodology_freeze_sha256",
    "git_revision"
  ],
  "systemic_defect_policy": "invalidate_freeze_fix_refreeze_reacquire"
}
